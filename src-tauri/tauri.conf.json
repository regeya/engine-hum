{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engine Hum",
  "version": "0.1.0",
  "identifier": "org.regeya.enginehum",
  "build": {
    "frontendDist": "../html"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Engine Hum",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
